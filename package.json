{
  "name": "u7-astra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "tsc --noEmit && npm run build:server && vite build --configLoader native",
    "start": "node build-server/server/index.js",
    "test": "npm run build:server && node --test build-server/tests/*.test.js",
    "setup": "npm run build:server && node build-server/scripts/admin.js setup",
    "sync:content": "npm run build:server && node build-server/scripts/sync-content.js",
    "check:upstream": "npm run build:server && node build-server/scripts/sync-content.js --check"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "markdown-to-telegram": "0.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "teleproto": "1.229.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
